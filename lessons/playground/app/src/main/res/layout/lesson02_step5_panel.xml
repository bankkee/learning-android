<?xml version="1.0" encoding="utf-8"?>
<!-- บทที่ 02 ขั้นที่ 5 — แผงสั่งกาแฟ: chain, guideline, barrier, group -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- แบบฝึก 5.1: ปุ่มสามปุ่มนี้ต้องกระจายเท่ากันเต็มความกว้าง -->
    <Button
        android:id="@+id/btnSizeS"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/panel_size_s"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnSizeM"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/panel_size_m"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnSizeL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/panel_size_l"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- guideline: เส้นอ้างอิงที่กึ่งกลางความกว้าง มองไม่เห็นในแอป -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideHalf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <TextView
        android:id="@+id/tvHot"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="4dp"
        android:background="#FFCCBC"
        android:gravity="center"
        android:text="@string/panel_hot"
        android:textSize="18sp"
        app:layout_constraintEnd_toStartOf="@id/guideHalf"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSizeM" />

    <TextView
        android:id="@+id/tvCold"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="4dp"
        android:background="#BBDEFB"
        android:gravity="center"
        android:text="@string/panel_cold"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/guideHalf"
        app:layout_constraintTop_toTopOf="@id/tvHot" />

    <!-- ป้ายสองบรรทัดที่ยาวไม่เท่ากัน -->
    <TextView
        android:id="@+id/tvLabelName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/panel_label_name"
        android:textColor="#6B6B6B"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHot" />

    <TextView
        android:id="@+id/tvLabelPhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/panel_label_phone"
        android:textColor="#6B6B6B"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLabelName" />

    <!-- แบบฝึก 5.2: ค่าสองบรรทัดนี้ต้องเริ่มหลังป้ายตัวที่ยาวที่สุด -->
    <TextView
        android:id="@+id/tvValueName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/panel_value_name"
        android:textColor="#4B3425"
        android:textSize="16sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvLabelName"
        app:layout_constraintStart_toEndOf="@id/tvLabelName" />

    <TextView
        android:id="@+id/tvValuePhone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/panel_value_phone"
        android:textColor="#4B3425"
        android:textSize="16sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvLabelPhone"
        app:layout_constraintStart_toEndOf="@id/tvLabelName" />

    <!-- สองตัวนี้อยู่ใน groupDelivery -->
    <TextView
        android:id="@+id/tvLabelAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/panel_label_address"
        android:textColor="#6B6B6B"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLabelPhone" />

    <TextView
        android:id="@+id/tvValueAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/panel_value_address"
        android:textColor="#4B3425"
        android:textSize="16sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tvLabelAddress"
        app:layout_constraintStart_toEndOf="@id/tvLabelAddress" />

    <!-- group: ซ่อนหรือแสดง View หลายตัวพร้อมกัน -->
    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupDelivery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="tvLabelAddress,tvValueAddress" />

</androidx.constraintlayout.widget.ConstraintLayout>
