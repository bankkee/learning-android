<?xml version="1.0" encoding="utf-8"?>
<!-- layout ของ QuantityStepperView ใช้ <merge> เพราะตัว View เป็น LinearLayout อยู่แล้ว จึงไม่ต้องมี layout ซ้อนอีกชั้น -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:orientation="horizontal"
    tools:parentTag="android.widget.LinearLayout">

    <Button
        android:id="@+id/btnMinus"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="@string/stepper_minus"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvQuantity"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/appBrownDark"
        android:textSize="18sp"
        tools:text="1" />

    <Button
        android:id="@+id/btnPlus"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:minWidth="0dp"
        android:padding="0dp"
        android:text="@string/stepper_plus"
        android:textSize="18sp" />

</merge>
